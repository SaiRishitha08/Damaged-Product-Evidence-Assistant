<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" width="400" height="400">
  <defs>
    <linearGradient id="grad-P04" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1e293b" />
      <stop offset="100%" stop-color="#0f172a" />
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#000000" flood-opacity="0.4" />
    </filter>
  </defs>
  <rect width="400" height="400" rx="28" fill="url(#grad-P04)" />
  <rect x="20" y="20" width="360" height="360" rx="20" fill="none" stroke="#334155" stroke-dasharray="8 8" stroke-width="2" />
  
  <!-- Outer synthetic rounded rect illustration -->
  <g filter="url(#shadow)">
    <rect x="70" y="70" width="260" height="260" rx="36" fill="#1e293b" stroke="#1d4ed8" stroke-width="4" />
    <path d="M150 130 L110 170 L140 200 L160 180 V290 H240 V180 L260 200 L290 170 L250 130 C235 150 165 150 150 130 Z" fill="#1d4ed8" />
       <path d="M175 130 C185 145 215 145 225 130" stroke="#0f172a" stroke-width="6" fill="none" />
       <rect x="175" y="195" width="50" height="40" rx="6" fill="white" opacity="0.2" />
  </g>

  <!-- Tag / Watermark indicating synthetic test fixture -->
  <rect x="85" y="305" width="230" height="26" rx="6" fill="#0f172a" opacity="0.85" />
  <text x="200" y="322" font-family="monospace" font-size="11" fill="#94a3b8" text-anchor="middle" font-weight="bold">SYNTHETIC FIXTURE • P04</text>
  <text x="200" y="52" font-family="sans-serif" font-size="13" fill="#cbd5e1" text-anchor="middle" font-weight="600">P04: Blue Tshirt</text>
</svg>