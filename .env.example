# Client-side Vite variables
# Copy this file to .env.local and replace every placeholder with your own values.
# VITE_* values are bundled into the browser. Do not put server-only secrets or deployment tokens here.

# Google Gemini Vision
VITE_GEMINI_API_KEY=

# Supabase browser client
# Use only the publishable/anon key here. Never expose a secret or service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional public deployment metadata
VITE_RENDER_PUBLIC_URL=
VITE_VERCEL_PUBLIC_URL=

# Render and Vercel deployment tokens are server/CI secrets.
# Store them in the hosting provider or CI secret manager, not in this file:
# RENDER_API_KEY=
# VERCEL_TOKEN=
